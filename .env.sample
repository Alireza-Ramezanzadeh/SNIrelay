# Copy to .env and edit:  cp .env.sample .env
# Prefer putting stable settings in snirelay.yaml; use this file for secrets
# and machine-specific overrides.

# ── Required ─────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me
# Public IP written into dnsmasq address=/domain/IP (overrides panel.relay_ip)
RELAY_IP=94.182.174.181

# ── Optional overrides (defaults come from snirelay.yaml / binary) ────────────
# CONFIG_FILE=/etc/sniproxy/config.yaml
# LOG_LEVEL=info
# LOG_FILE=

# Override default upstream only (named profiles stay in YAML)
# PROXY=socks5 127.0.0.1 10808

# Panel
# PANEL_ENABLED=true
# PANEL_ADDR=0.0.0.0:9080

# dnsmasq live edit + query log (also configurable under panel: in YAML)
# Mount required in compose: /etc/dnsmasq.d:/etc/dnsmasq.d
DNSMASQ_CONF_DIR=/etc/dnsmasq.d
# DNSMASQ_RELAY_FILE=/etc/dnsmasq.d/routed.conf
# DNSMASQ_BYPASS_FILE=/etc/dnsmasq.d/bypass.conf
# DNSMASQ_RELOAD_CMD=kill -HUP $(pidof dnsmasq)
# (In Docker, snirelay runs this via nsenter into host PID 1 — needs privileged + pid:host)
DNSMASQ_QUERY_LOG=/var/log/dnsmasq/queries.log
# DNS_QUERY_RETAIN_HOURS=72

# Upstream probe (Docker/Xray race)
# UPSTREAM_PROBE_REQUIRED=false
# UPSTREAM_PROBE_WAIT_SECS=60
# UPSTREAM_PROBE_INTERVAL_SECS=2

# Loopback remap when not using host network
# HOST_PROXY_GATEWAY=off

# Client IP whitelist → also sync UFW (panel Whitelist tab)
# CLIENT_WHITELIST_UFW=true
# UFW_BIN=/usr/sbin/ufw

# Upstream monitor + Telegram alerts (enable + set token/chat)
# UPSTREAM_MONITOR_ENABLED=true
# UPSTREAM_MONITOR_INTERVAL_SECS=60
# UPSTREAM_MONITOR_TIMEOUT_SECS=10
# UPSTREAM_MONITOR_FAIL_THRESHOLD=2
# UPSTREAM_MONITOR_PROBE_HOST=ifconfig.io
# UPSTREAM_MONITOR_PROBE_PORT=443
# UPSTREAM_MONITOR_PROBE_HOSTS=ifconfig.io:443,example.com:443
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_API_BASE=https://telegram.example.com   # custom proxy/mirror
